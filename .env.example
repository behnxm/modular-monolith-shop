# Database Configuration
POSTGRES_DB=shop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_superadmin_password

# Module Role Passwords
SHOP_MIGRATOR_PASSWORD=migrator_secure_password_2026
CATALOG_APP_PASSWORD=catalog_secure_password_2026
INVENTORY_APP_PASSWORD=inventory_secure_password_2026
ORDERING_APP_PASSWORD=ordering_secure_password_2026
PAYMENTS_APP_PASSWORD=payments_secure_password_2026
NOTIFICATIONS_APP_PASSWORD=notifications_secure_password_2026

# Connection Strings
ConnectionStrings__Migrator=Host=localhost;Port=5432;Database=shop;Username=shop_migrator;Password=migrator_secure_password_2026
ConnectionStrings__catalog=Host=localhost;Port=5432;Database=shop;Username=catalog_app;Password=catalog_secure_password_2026
ConnectionStrings__inventory=Host=localhost;Port=5432;Database=shop;Username=inventory_app;Password=inventory_secure_password_2026
ConnectionStrings__ordering=Host=localhost;Port=5432;Database=shop;Username=ordering_app;Password=ordering_secure_password_2026
ConnectionStrings__payments=Host=localhost;Port=5432;Database=shop;Username=payments_app;Password=payments_secure_password_2026
ConnectionStrings__notifications=Host=localhost;Port=5432;Database=shop;Username=notifications_app;Password=notifications_secure_password_2026

# Application Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
Database__UseMigratorConnection=false

# Authentication & Development Token Issuer
# DevIssuer must ONLY be enabled in Development/Demonstration
DevIssuer__Enabled=true
DevIssuer__SigningKeyPath=secrets/dev-issuer.key
Authentication__Authority=https://auth.shop.local
Authentication__Audience=shop-api

# Module Outbox Configuration Defaults
Modules__catalog__Outbox__PollIntervalMs=500
Modules__inventory__Outbox__PollIntervalMs=500
Modules__ordering__Outbox__PollIntervalMs=500
Modules__payments__Outbox__PollIntervalMs=500
Modules__notifications__Outbox__PollIntervalMs=500

# Payments Mock Gateway Approval Limit
Modules__Payments__ApprovalLimit=10000

# OpenTelemetry Exporter Endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
